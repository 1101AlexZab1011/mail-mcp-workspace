{
  "mcpServers": {
    "mail-workflow": {
      "type": "stdio",
      "command": "node",
      "args": [
        "src/main.mjs",
        "stdio"
      ]
    },
    "mail-attachments": {
      "type": "stdio",
      "command": "node",
      "args": [
        "src/attachments-main.mjs",
        "stdio"
      ]
    },
    "listener": {
      "type": "stdio",
      "command": "listener-mcp",
      "args": [
        "mcp"
      ]
    },
    "mail-gui": {
      "type": "stdio",
      "command": "node",
      "args": [
        "src/gui-main.mjs"
      ]
    }
  }
}
