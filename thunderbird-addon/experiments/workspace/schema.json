[
  {
    "namespace": "workspace",
    "description": "Chrome-level layout and automation for Mail Workspace: docks, theme, spaces, GUI state and actions.",
    "types": [
      {
        "id": "Dock",
        "type": "object",
        "properties": {
          "side": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "minimized",
              "maximized"
            ]
          },
          "width": {
            "type": "integer"
          }
        }
      }
    ],
    "functions": [
      {
        "name": "install",
        "type": "function",
        "async": true,
        "description": "Apply the workspace layout to every messenger window, now and for windows opened later.",
        "parameters": [
          {
            "name": "options",
            "type": "object",
            "properties": {
              "leftUrl": {
                "type": "string"
              },
              "rightUrl": {
                "type": "string"
              },
              "defaults": {
                "type": "object",
                "additionalProperties": {
                  "type": "any"
                },
                "optional": true
              },
              "filesSide": {
                "type": "string",
                "optional": true
              },
              "terminalUrl": {
                "type": "string",
                "optional": true
              }
            }
          }
        ]
      },
      {
        "name": "getDocks",
        "type": "function",
        "async": true,
        "parameters": []
      },
      {
        "name": "setDock",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "side",
            "type": "string",
            "enum": [
              "left",
              "right"
            ]
          },
          {
            "name": "change",
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "optional": true,
                "enum": [
                  "open",
                  "minimized",
                  "maximized",
                  "toggle"
                ]
              },
              "width": {
                "type": "integer",
                "optional": true
              }
            }
          }
        ]
      },
      {
        "name": "openSpace",
        "type": "function",
        "async": true,
        "description": "Open a built-in space: mail, addressbook, calendar, tasks, settings.",
        "parameters": [
          {
            "name": "name",
            "type": "string"
          }
        ]
      },
      {
        "name": "getState",
        "type": "function",
        "async": true,
        "description": "What is active and selected in the chrome: space, folder, messages, calendar, tasks, contacts, docks.",
        "parameters": []
      },
      {
        "name": "snapshot",
        "type": "function",
        "async": true,
        "description": "A compact list of visible, actionable chrome elements with refs.",
        "parameters": [
          {
            "name": "options",
            "type": "object",
            "optional": true,
            "properties": {
              "scope": {
                "type": "string",
                "optional": true
              },
              "limit": {
                "type": "integer",
                "optional": true
              },
              "query": {
                "type": "string",
                "optional": true
              }
            }
          }
        ]
      },
      {
        "name": "act",
        "type": "function",
        "async": true,
        "description": "Act on a snapshot ref: click, dblclick, rightclick, type, select, focus, scroll, hover. With check=true only classifies the action.",
        "parameters": [
          {
            "name": "ref",
            "type": "string"
          },
          {
            "name": "action",
            "type": "string"
          },
          {
            "name": "value",
            "type": "string",
            "optional": true
          },
          {
            "name": "options",
            "type": "object",
            "optional": true,
            "properties": {
              "check": {
                "type": "boolean",
                "optional": true
              }
            }
          }
        ]
      },
      {
        "name": "spaceShown",
        "type": "function",
        "async": true,
        "description": "Whether the space of this name (one of ours) has its button on the toolbar.",
        "parameters": [{ "name": "name", "type": "string" }]
      },
      {
        "name": "dropSpace",
        "type": "function",
        "async": true,
        "description": "Forget a space of ours whose button is gone, so one of that name can be made again.",
        "parameters": [{ "name": "name", "type": "string" }]
      },
      {
        "name": "pressKey",
        "type": "function",
        "async": true,
        "description": "Send a trusted key combination (e.g. \"Control+Shift+K\") to the focused element. With check=true only classifies it.",
        "parameters": [
          {
            "name": "combo",
            "type": "string"
          },
          {
            "name": "options",
            "type": "object",
            "optional": true,
            "properties": {
              "check": {
                "type": "boolean",
                "optional": true
              }
            }
          }
        ]
      },
      {
        "name": "screenshot",
        "type": "function",
        "async": true,
        "description": "PNG data URL of the main window, or of a snapshot ref's element.",
        "parameters": [
          {
            "name": "options",
            "type": "object",
            "optional": true,
            "properties": {
              "ref": {
                "type": "string",
                "optional": true
              },
              "scale": {
                "type": "number",
                "optional": true
              }
            }
          }
        ]
      },
      {
        "name": "selectMail",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "folderUri",
            "type": "string",
            "optional": true
          },
          {
            "name": "messageKeys",
            "type": "array",
            "items": {
              "type": "integer"
            },
            "optional": true
          }
        ]
      },
      {
        "name": "calendarGoto",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "date",
            "type": "string"
          },
          {
            "name": "view",
            "type": "string",
            "optional": true
          }
        ]
      },
      {
        "name": "focusOwnTab",
        "type": "function",
        "async": true,
        "description": "Mark add-on tabs so the content-tab address bar is hidden for them.",
        "parameters": []
      },
      {
        "name": "openWeb",
        "type": "function",
        "async": true,
        "description": "Open an address or search words in a session's web tab shown last, or in a new one (the current session unless named; an unknown name makes one).",
        "parameters": [
          { "name": "input", "type": "string", "optional": true },
          {
            "name": "options",
            "type": "object",
            "optional": true,
            "properties": { "newTab": { "type": "boolean", "optional": true }, "session": { "type": "string", "optional": true } }
          }
        ]
      },
      {
        "name": "webState",
        "type": "function",
        "async": true,
        "description": "The Browser's sessions and web tabs: id, url, title, session, loading, current, active.",
        "parameters": []
      },
      {
        "name": "webSession",
        "type": "function",
        "async": true,
        "description": "Switch to, create or rename a Browser session (deleting one is the user's alone).",
        "parameters": [
          { "name": "action", "type": "string", "enum": ["switch", "create", "rename"] },
          { "name": "name", "type": "string", "optional": true },
          { "name": "newName", "type": "string", "optional": true }
        ]
      },
      {
        "name": "webNavigate",
        "type": "function",
        "async": true,
        "description": "Back, forward, reload, stop or close in the active web tab.",
        "parameters": [{ "name": "action", "type": "string", "enum": ["back", "forward", "reload", "stop", "close"] }]
      },
      {
        "name": "webClick",
        "type": "function",
        "async": true,
        "description": "A real mouse click at a point of the active web tab's page (content CSS pixels).",
        "parameters": [{ "name": "x", "type": "number" }, { "name": "y", "type": "number" }]
      },
      {
        "name": "setAppearance",
        "type": "function",
        "async": true,
        "description": "Light, dark or system appearance for Thunderbird's window (built-in themes) and the Mail Workspace theme.",
        "parameters": [
          {
            "name": "mode",
            "type": "string",
            "enum": [
              "system",
              "light",
              "dark"
            ]
          }
        ]
      },
      {
        "name": "setTerminal",
        "type": "function",
        "async": true,
        "description": "Show, hide, maximize or size the bottom terminal panel.",
        "parameters": [
          {
            "name": "change",
            "type": "object",
            "properties": {
              "visible": {
                "type": "boolean",
                "optional": true
              },
              "toggle": {
                "type": "boolean",
                "optional": true
              },
              "maximized": {
                "type": "boolean",
                "optional": true
              },
              "height": {
                "type": "integer",
                "optional": true
              }
            }
          }
        ]
      },
      {
        "name": "getTerminal",
        "type": "function",
        "async": true,
        "parameters": []
      }
    ],
    "events": [
      {
        "name": "onDockChanged",
        "type": "function",
        "parameters": [
          {
            "name": "dock",
            "$ref": "Dock"
          }
        ]
      },
      {
        "name": "onShortcut",
        "type": "function",
        "parameters": [
          {
            "name": "name",
            "type": "string"
          }
        ]
      }
    ]
  }
]
