{
  "manifest_version": 2,
  "name": "Mail Workspace",
  "description": "Agent-first workspace for Thunderbird: chat and file docks, file viewer, artifacts, paint, and GUI control for your agent.",
  "version": "2.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "agent-chat@mail-mcp-workspace.local",
      "strict_min_version": "140.0"
    }
  },
  "background": {
    "page": "background.html"
  },
  "experiment_apis": {
    "workspace": {
      "schema": "experiments/workspace/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "workspace"
          ]
        ],
        "script": "experiments/workspace/implementation.js",
        "events": [
          "startup"
        ]
      }
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "tabs",
    "accountsRead",
    "messagesRead",
    "http://127.0.0.1/*",
    "clipboardRead",
    "clipboardWrite"
  ],
  "web_accessible_resources": [
    "icons/*",
    "shared/*",
    "theme/*"
  ],
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
}
