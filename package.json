{
  "name": "mail-mcp-workspace",
  "version": "1.0.0",
  "description": "Provider-neutral email MCP workspace with optional workflow automation",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "configure": "email-mcp account add",
    "verify": "email-mcp test",
    "mcp": "email-mcp stdio",
    "workflow": "node src/main.mjs",
    "attachments": "node src/attachments-main.mjs",
    "workflow:mcp": "node src/main.mjs stdio",
    "workflow:sync": "node src/main.mjs sync",
    "workflow:watch": "node src/main.mjs watch",
    "workflow:install-watcher": "node src/main.mjs install-watcher-service",
    "workflow:init": "node src/main.mjs init",
    "chat:addon": "mkdir -p dist && (cd thunderbird-addon && zip -qr ../dist/agent-chat.xpi .)",
    "test": "node --test"
  },
  "keywords": [
    "mcp",
    "email",
    "imap",
    "smtp",
    "thunderbird"
  ],
  "bin": {
    "mail-workflow-mcp": "src/main.mjs",
    "mail-attachments-mcp": "src/attachments-main.mjs"
  },
  "type": "module",
  "dependencies": {
    "@codefuturist/email-mcp": "^0.2.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/browser": "^4.3.3",
    "dompurify": "^3.4.14",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "imapflow": "^1.7.7",
    "katex": "^0.18.5",
    "listener-mcp": "github:1101AlexZab1011/listener-mcp",
    "lucide-react": "^1.49.0",
    "marked": "^18.0.11",
    "material-icon-theme": "^5.38.1",
    "nodemailer": "^7.0.13",
    "pdfjs-dist": "^6.3.289",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "shiki": "^4.4.3",
    "smol-toml": "^1.8.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "^0.47.5"
  }
}
